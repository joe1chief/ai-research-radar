# Runtime
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
RADAR_DATABASE_URL=sqlite:///./radar.db
RADAR_CONFIG_DIR=./configs
RADAR_PUBLIC_DATA_PATH=./web/public/data/latest.json
RADAR_DRY_RUN=true
LOG_LEVEL=INFO

# General HTTP identity used by non-SEC collectors.
RADAR_USER_AGENT=AIResearchRadar/0.1 contact=you@example.com
# Required for SEC collection. Format the value as
# AIResearchRadar/0.1 contact=<public-operations-email>; replace the placeholder.
SEC_USER_AGENT=

# Model provider. The selected provider and base URL must remain paired.
# DashScope is the backward-compatible default.
LLM_PROVIDER=dashscope
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CLASSIFIER_MODEL=qwen-flash
LLM_SUMMARIZER_MODEL=qwen-plus
LLM_JSON_RESPONSE_FORMAT=true
LLM_MAX_TOKENS=1200
# Leave LLM_ENABLE_THINKING unset: DashScope defaults to false and YiCloud omits it.
LLM_EMBEDDING_MODE=shared
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSIONS=1024
LLM_DAILY_CLASSIFY_LIMIT=300
LLM_DAILY_SUMMARY_LIMIT=20
LLM_DAILY_REEMBED_LIMIT=100

# YiCloud TokenFactory alternative (not YiCloud MaaS). Use account-verified model IDs.
# LLM_PROVIDER=yicloud
# LLM_BASE_URL=https://token-api.yicloud.com/v1
# LLM_CLASSIFIER_MODEL=
# LLM_SUMMARIZER_MODEL=
# LLM_EMBEDDING_MODE=local

# Optional independent remote embedding provider. Keep this unset for YiCloud's
# initial intentional-local configuration.
# LLM_EMBEDDING_API_KEY=
# LLM_EMBEDDING_BASE_URL=https://example-embedding-provider.invalid/v1

# Legacy DASHSCOPE_* and QWEN_* variable aliases remain accepted by the backend.

# alphaXiv enrichment is optional; arXiv remains canonical
ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1
ALPHAXIV_ACCESS_TOKEN=
ALPHAXIV_DAILY_READ_LIMIT=5

# Optional; guest access is attempted first, but some networks receive a challenge
OPENREVIEW_ACCESS_TOKEN=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
DIGEST_RECIPIENT=
DELIVERY_MODE=shadow

# Supabase / production database
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
RADAR_RAW_STORAGE_BUCKET=radar-raw
RADAR_RAW_SNAPSHOT_MAX_BYTES=5242880

# Public archive
PUBLIC_BASE_URL=http://localhost:4173
GITHUB_PAGES_BASE_PATH=/
