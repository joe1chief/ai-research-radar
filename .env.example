# Runtime
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
RADAR_DATABASE_URL=sqlite:///./radar.db
RADAR_CONFIG_DIR=./configs
RADAR_PUBLIC_DATA_PATH=./web/public/data/latest.json
RADAR_DRY_RUN=true
LOG_LEVEL=INFO

# HTTP identity (required by SEC and recommended for all collectors)
RADAR_USER_AGENT=AIResearchRadar/0.1 contact=you@example.com

# Alibaba Cloud Model Studio (Beijing region)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CLASSIFIER_MODEL=qwen-flash
QWEN_SUMMARIZER_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_DAILY_CLASSIFY_LIMIT=300
QWEN_DAILY_SUMMARY_LIMIT=20
QWEN_DAILY_REEMBED_LIMIT=100

# alphaXiv enrichment is optional; arXiv remains canonical
ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1
ALPHAXIV_ACCESS_TOKEN=
ALPHAXIV_DAILY_READ_LIMIT=5

# Optional; guest access is attempted first, but some networks receive a challenge
OPENREVIEW_ACCESS_TOKEN=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
DIGEST_RECIPIENT=
DELIVERY_MODE=shadow

# Supabase / production database
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
RADAR_RAW_STORAGE_BUCKET=radar-raw
RADAR_RAW_SNAPSHOT_MAX_BYTES=5242880

# Public archive
PUBLIC_BASE_URL=http://localhost:4173
GITHUB_PAGES_BASE_PATH=/
